<Project Sdk="Microsoft.NET.Sdk">
  <!-- Бэкенд RHI на Vulkan 1.1+ (этап 10). Шейдеры GLSL 330 ассетов переводятся в GLSL 450 и компилируются
       в SPIR-V при загрузке (Shaderc). Выбирает хост ключом backend vulkan. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mvk.Rendering\Mvk.Rendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Shaderc" />
    <PackageReference Include="Silk.NET.Shaderc.Native" />
  </ItemGroup>
</Project>

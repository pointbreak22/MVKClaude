<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Снимки кадров СТАРОГО клиента (original/, коммит dfbd814) для сравнения с портом (этап 6).
    Оригинал собирается как есть через tools/GoldenGen/Original/*.csproj, здесь только подкласс WindowMvk,
    который сам запускает одиночную игру, ставит взгляд, шлёт команды и сохраняет кадр в PNG.
    Не входит в MvkClaude.slnx: original/ не хранится в git. Запуск: см. tools/OrigShot/README.md
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Mvk.Core\Util\PngWriter.cs" Link="PngWriter.cs" />
    <None Include="..\..\original\res\Assets\**\*" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Оригинал ищет OpenAL64.dll рядом с exe (в репозитории её нет): кладём OpenAL Soft под этим именем -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="CopyOpenAL64" AfterTargets="Build">
    <Copy SourceFiles="$(PkgSilk_NET_OpenAL_Soft_Native)/runtimes/win-x64/native/soft_oal.dll"
          DestinationFiles="$(OutDir)OpenAL64.dll" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\GoldenGen\Original\Mvk2\Mvk2.csproj" />
  </ItemGroup>
</Project>
